<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/lavender_350"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Lesson Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <View
                android:layout_width="5dp"
                android:layout_height="26dp"
                android:background="@color/accent_purple_lighter" />

            <TextView
                android:id="@+id/tvLessonTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/lesson_title_placeholder"
                android:textColor="@color/text_primary_soft"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Date -->
        <TextView
            android:id="@+id/tvLessonDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="17dp"
            android:layout_marginTop="10dp"
            android:text="@string/lesson_date_placeholder"
            android:textColor="@color/text_muted_lavender"
            android:textSize="12sp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditLesson"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="76dp"
                android:minHeight="42dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/action_edit"
                android:textAllCaps="false"
                android:textColor="@color/accent_purple_dark"
                android:textSize="13sp"
                app:backgroundTint="@color/lavender_50"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteLesson"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:minWidth="76dp"
                android:minHeight="42dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/action_delete"
                android:textAllCaps="false"
                android:textColor="@color/error_text_soft"
                android:textSize="13sp"
                app:backgroundTint="@color/error_surface"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
