<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/lavender_300"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Topic header -->
        <LinearLayout
            android:id="@+id/topicHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbTopicCompleted"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:button="@drawable/topic_checkbox_selector"
                android:buttonTint="@null"
                android:contentDescription="@string/cd_mark_topic_completed"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:saveEnabled="true" />


            <TextView
                android:id="@+id/tvTopicTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="@string/topic_title_placeholder"
                android:textColor="@color/text_primary_dark_purple"
                android:textSize="15sp"
                android:textStyle="bold"
                android:breakStrategy="simple" />

            <ImageButton
                android:id="@+id/btnEditTopic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_edit_topic"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/purple_500" />

            <ImageButton
                android:id="@+id/btnDeleteTopic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_delete_topic"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/error_rose_light" />

            <TextView
                android:id="@+id/tvTopicArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="7dp"
                android:paddingEnd="3dp"
                android:text="@string/symbol_chevron_down"
                android:textColor="@color/text_tertiary_lavender"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Topic description -->
        <TextView
            android:id="@+id/tvTopicDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/topic_description_placeholder"
            android:textColor="@color/text_secondary_alt"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
