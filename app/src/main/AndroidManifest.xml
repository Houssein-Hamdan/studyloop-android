<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/studyloop_ic"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/studyloop_ic_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyLoopAndroid">
        <activity
            android:name=".ui.auth.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.learning.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.learning.LessonsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.learning.LessonDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.learning.CreateLessonActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.review.ReviewActivity"
            android:exported="false" />
        <activity
            android:name=".ui.analytics.AnalyticsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ask.AskAIActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.auth.StartupActivity"
            android:exported="true"
            android:theme="@style/Theme.StudyLoopAndroid.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>
        </activity>
        <activity
            android:name=".ui.quiz.TakeQuizActivity"
            android:exported="false" />
        <activity
            android:name=".ui.summary.SummaryDetailsActivity"
            android:exported="false" />
    </application>

</manifest>
